---
const { title } = Astro.props;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 p-8">
    <main class="max-w-3xl mx-auto bg-white p-8 rounded-xl shadow-sm">
      <slot /> </main>
  </body>
</html>
